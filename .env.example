# Variáveis de ambiente do Vincii Canvas.
#
# NENHUMA é obrigatória para o uso básico. Copie para `.env` só se precisar
# ajustar algo — o app lê as variáveis do ambiente do processo, não deste
# arquivo (não há loader de .env embutido); este arquivo é a REFERÊNCIA do que
# existe. NÃO coloque segredos reais aqui, e não versione o seu `.env`.

# --- Servidor / modo web ---
# Porta do modo web (`npm start`). No app desktop a porta é aleatória.
PORT=3033

# --- IA (Anthropic) ---
# Chave da API. Tem precedência sobre a chave gravada nas Configurações
# (data.json). Deixe em branco para usar a da interface.
ANTHROPIC_API_KEY=

# --- Autenticação por agente SSH ---
# Necessária para hosts com auth "agente". Normalmente já vem do ambiente ao
# iniciar pelo terminal; listada aqui só para lembrar da dependência.
# SSH_AUTH_SOCK=

# --- Diretório de dados ---
# Onde ficam data.json, history.json e cofres-chaves.json. O app desktop aponta
# para o perfil do usuário; no modo web, o padrão é a raiz do projeto.
# SSHC_DATA_DIR=

# Marca o modo desktop (definido pelo processo do Electron). Não defina à mão.
# SSHC_DESKTOP=

# --- Ajustes finos de RDP (opcionais) ---
# Timeout do handshake do RDP legado, em ms.
# VC_RDP_HS_MS=30000
# Desliga o autologon do RDP (1 = desligado).
# VC_RDP_SEM_AUTOLOGON=
# Desliga o alinhamento de retângulos do bitmap (contorno de bug do ironrdp-wasm).
# VC_RDP_SEM_ALINHAR=

# --- Sessões e cofre (opcionais) ---
# TTL de uma sessão de terminal órfã antes do servidor derrubá-la, em ms.
# VC_TERM_TTL_MS=300000
# Timeout das chamadas HTTP aos cofres, em ms.
# VC_COFRE_TIMEOUT_MS=15000

# --- Servidores locais de teste (opcionais) ---
# Porta do SSHd local de teste (test/sshd-local.js).
# SSHD_LOCAL_PORT=2222
